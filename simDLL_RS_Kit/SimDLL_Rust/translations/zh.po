#. mod.yaml description
msgctxt "SimDLL_Rust.mod_description"
msgid "Rust-based SimDLL"
msgstr "基于 Rust 的 SimDLL"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.DIALOG_TITLE
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.DIALOG_TITLE"
msgid "SimDLL_Rust Config"
msgstr "SimDLL_Rust 配置"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.LOG_ENABLED_LABEL
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.LOG_ENABLED_LABEL"
msgid "Enable Logging"
msgstr "启用日志功能"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.HYPERTHREAD_LABEL
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.HYPERTHREAD_LABEL"
msgid "Enable Hyper-Threading Optimization"
msgstr "启用超线程优化"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.RESERVED_CORES_LABEL
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.RESERVED_CORES_LABEL"
msgid "Reserve physical thread count"
msgstr "预留物理线程数量"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.SLICE_SIZE_LABEL
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.SLICE_SIZE_LABEL"
msgid "Temperature Slicing (Experimental)"
msgstr "温度切片并行（实验性）"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.SLICE_HINT
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.SLICE_HINT"
msgid "OFF = disabled (default). Choosing any size enables it: the temperature pass is split into tiles for multi-core parallelization. Smaller slices give more parallelism but higher scheduling overhead. Choose OFF if you observe temperature anomalies."
msgstr "OFF 为关闭（默认）。选择任意尺寸即启用：把温度阶段切成瓦片做多核并行。切片越小并行度越高，但调度开销也越大。若观察到温度异常，选回 OFF 即可"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.LOG_PATH_HINT
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.LOG_PATH_HINT"
msgid "Logs are saved in the game installation directory by default."
msgstr "日志默认保存在游戏安装目录"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.HYPERTHREAD_HINT
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.HYPERTHREAD_HINT"
msgid "Make sure Hyper-Threading is enabled on your CPU before turning this on, otherwise it will be automatically disabled."
msgstr "启用超线程优化前，确保你的CPU开启了超线程，否则会自动禁用"

#. SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.RESTART_HINT
msgctxt "SimDLL_Rust.STRINGS.UI.FRONTEND.MOD_OPTIONS.RESTART_HINT"
msgid "After modifying the settings, it is necessary to restart the game."
msgstr "修改设置后需重启游戏生效"
